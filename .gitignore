# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
# Keep dependency lockfiles (including package-lock.json) in version control.

# Generated builds and bundler caches
dist/
build/
.vite/
.vite-temp/
vite.config.*.timestamp-*
node_modules.cache
.vitepress/cache/
.vitepress/dist/

# Test coverage and browser-test artifacts
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Local environment variables; keep safe templates available to commit
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Logs and runtime diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Temporary files and local caches
.cache/
.temp/
.backup/
/tmp/
/temp/
*.tmp
*.temp
*.bak

# TypeScript incremental build state
*.tsbuildinfo

# Generated local implementation/build reports
/build_report.txt
/final_report.txt
/visual_rework_report.txt
